# ==========================================
# SastaSMS Professional OTP Telegram Bot Config
# ==========================================

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. SastaSMS API Key from https://sastasms.pro dashboard
SASTASMS_API_KEY=YOUR_SASTASMS_API_KEY_HERE

# 3. Admin Telegram IDs (comma-separated integers)
# Example: 123456789,987654321
ADMIN_IDS=123456789

# 4. Profit Margin Configuration
# Markup in percentage (e.g. 20 means 20% profit on provider price)
DEFAULT_MARGIN_PERCENT=20.0
# Flat markup in INR (e.g. 1.0 means +₹1 extra on every number)
DEFAULT_MARGIN_FLAT=1.0

# 5. UPI Recharge Settings
DEFAULT_UPI_ID=yourname@okaxis
DEFAULT_UPI_NAME=OTP Service
MIN_RECHARGE=10.0

# 6. Advanced Settings
ORDER_TIMEOUT_MINUTES=20
POLL_INTERVAL_SECONDS=4
BASE_API_URL=https://sastasms.pro/stubs/handler_api.php
DB_PATH=bot_database.db
